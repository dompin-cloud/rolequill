# Copy this file to ".env" (same folder) and fill in your keys.
# The app loads .env automatically at startup — no terminal env vars needed.
# Real environment variables, if set, take precedence over .env.

# --- Google Jobs (SerpApi) ---
# Get a key at https://serpapi.com (free tier: 100 searches/month)
SERPAPI_KEY=your_serpapi_key_here
# Google result pages per search (1 page ~= 10 jobs = 1 SerpApi credit)
ROLEQUILL_GOOGLE_PAGES=1

# --- Flask / app ---
# Long random string — generate: python -c "import secrets; print(secrets.token_hex(32))"
ROLEQUILL_SECRET=change-me-to-a-long-random-string
# Production toggles (set these on your host; leave at 0 for local dev)
ROLEQUILL_DEBUG=0
ROLEQUILL_HTTPS=1          # 1 in production (HTTPS) so session cookies are Secure
ROLEQUILL_BEHIND_PROXY=1   # 1 when behind Cloudflare / a reverse proxy

# --- Search tuning (optional) ---
# JOBSEARCH_MAX_COMPANIES=60
# JOBSEARCH_WORKERS=16

# --- Payments / Stripe ---
# 'stub' = instant test fulfillment; 'stripe' = real charges
ROLEQUILL_PAYMENTS_MODE=stub
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: pre-created Stripe Price IDs (otherwise prices are created inline)
# STRIPE_PRICE_STARTER=price_xxx
# STRIPE_PRICE_PLUS=price_xxx
# STRIPE_PRICE_PRO=price_xxx
